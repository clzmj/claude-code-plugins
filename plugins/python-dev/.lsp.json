{
  "ruff": {
    "command": "uvx",
    "args": ["ruff", "server", "--config", "${CLAUDE_PLUGIN_ROOT}/ruff.toml"],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    }
  },
  "ty": {
    "command": "uvx",
    "args": ["ty", "server"],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    }
  }
}
