# Multi-stage Dockerfile for Python projects using uv
# Optimized for minimal image size and fast builds

# === Builder Stage ===
FROM python:3.12-slim AS builder

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies (frozen, no-dev, no-editable)
# This layer is cached and reused unless pyproject.toml or uv.lock change
RUN uv sync --frozen --no-dev --no-editable

# === Runtime Stage ===
FROM python:3.12-slim

WORKDIR /app

# Copy pre-built virtual environment from builder
COPY --from=builder /app/.venv /app/.venv

# Copy application code
COPY . .

# Set environment to use the venv
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# Health check (optional)
# HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
#   CMD python -c "import requests; requests.get('http://localhost:8000/health')"

# Run application
CMD ["python", "-m", "app"]
